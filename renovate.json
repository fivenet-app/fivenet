{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>nuxt/renovate-config-nuxt",
        "helpers:pinGitHubActionDigests"
    ],
    "schedule": [
      "at any time"
    ],
    "baseBranchPatterns": ["develop"],
    "lockFileMaintenance": {
        "enabled": true
    },
    "osvVulnerabilityAlerts": true,
    "vulnerabilityAlerts": {
        "enabled": true
    },
    "packageRules": [
        {
            "matchManagers": ["gomod"],
            "groupName": "go modules",
            "groupSlug": "go-modules"
        },
        {
            "matchManagers": ["gomod"],
            "matchDepTypes": ["golang"],
            "matchDepNames": ["go"],
            "groupName": "go toolchain",
            "groupSlug": "go-toolchain",
            "rangeStrategy": "bump"
        },
        {
            "matchDatasources": ["npm"],
            "matchPackageNames": ["nuxt", "@nuxt/ui"],
            "minimumReleaseAge": null
        },
        {
            "matchManagers": ["gomod"],
            "matchPackageNames": ["github.com/fivenet-app/fivenet/**"],
            "minimumReleaseAge": null
        },
        {
            "matchManagers": ["gomod"],
            "matchPackageNames": ["golang.org/x/**"],
            "minimumReleaseAge": null
        }
    ],
    "postUpdateOptions": ["gomodTidy", "pnpmDedupe"],
    "dependencyDashboard": true,
    "nix": {
        "enabled": true
    },
    "minimumReleaseAge": "16 hours"
}
